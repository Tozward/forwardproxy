+func TestIdleTimeoutReaderDisableWhileReading(t *testing.T) {
+	now := time.Now()
+	for _, tc := range []struct {
+		name                string
+		hard, handler, want time.Time
+		clear               bool
+	}{
+		{name: "HTTP2 clears timer", clear: true},
+		{name: "HTTP3 clears deadline"},
+		{name: "hard ceiling", hard: now.Add(time.Hour), handler: now.Add(2 * time.Hour), want: now.Add(time.Hour)},
+		{name: "handler ceiling", hard: now.Add(2 * time.Hour), handler: now.Add(time.Hour), want: now.Add(time.Hour)},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			body := &blockingReadCloser{started: make(chan struct{}), release: make(chan struct{})}
+			rec := &readDeadlineRecorder{ResponseRecorder: httptest.NewRecorder()}
+			r := &IdleTimeoutReader{
+				ReadCloser:        body,
+				Ctrl:              http.NewResponseController(rec),
+				Deadline:          IdleDeadline{Start: now, Timeout: time.Minute, MinRate: 10, HardDeadline: tc.hard},
+				Logger:            zap.NewNop(),
+				ClearBetweenReads: tc.clear,
+			}
+			require.NoError(t, r.SetReadDeadline(tc.handler))
+			restoreOuter := r.Override(time.Minute, 10)
+			restoreInner := r.Override(time.Minute, 0)
+			done := make(chan struct{})
+			go func() {
+				defer close(done)
+				_, _ = r.Read(make([]byte, 1))
+			}()
+			t.Cleanup(func() {
+				close(body.release)
+				<-done
+			})
+			<-body.started
+			before := rec.snapshot()
+			require.Len(t, before, 2)
+			assert.Equal(t, deadlineIdle, r.armed)
+			assert.True(t, r.reading)
+			r.Disable()
+			r.Disable()
+			restoreInner()
+			restoreOuter()
+			assert.Equal(t, append(before, tc.want), rec.snapshot())
+			assert.Equal(t, tc.want, r.installed)
+			if tc.want.IsZero() {
+				assert.Equal(t, deadlineNone, r.armed)
+			} else {
+				assert.Equal(t, deadlineHard, r.armed)
+			}
+			assert.True(t, r.reading)
+			require.NoError(t, r.SetReadDeadline(time.Time{}))
+			assert.Equal(t, tc.hard, r.installed, "clearing the handler deadline must preserve HardDeadline")
+		})
+	}
+}
