+func TestIdleTimeoutWriterDisableAfterFlush(t *testing.T) {
+	for _, clear := range []bool{true, false} {
+		t.Run(fmt.Sprintf("clearBetweenWrites=%t", clear), func(t *testing.T) {
+			rec := &writeDeadlineRecorder{ResponseRecorder: httptest.NewRecorder()}
+			w := &IdleTimeoutWriter{
+				ResponseWriterWrapper: &ResponseWriterWrapper{ResponseWriter: rec},
+				Ctrl:                  http.NewResponseController(rec),
+				Deadline:              IdleDeadline{Start: time.Now(), Timeout: time.Minute, MinRate: 10},
+				Logger:                zap.NewNop(),
+				ClearBetweenWrites:    clear,
+			}
+			restoreOuter := w.Override(time.Minute, 10, 0)
+			restoreInner := w.Override(time.Minute, 0, 0)
+			require.NoError(t, w.FlushError())
+			require.Equal(t, !clear, w.deadlineSet)
+			want := append([]time.Time(nil), rec.deadlines...)
+			if !clear {
+				want = append(want, time.Time{})
+			}
+			w.Disable()
+			w.Disable()
+			restoreInner()
+			restoreOuter()
+			require.False(t, w.deadlineSet)
+			_, err := w.Write([]byte("stream"))
+			require.NoError(t, err)
+			_, err = w.ReadFrom(strings.NewReader("continues"))
+			require.NoError(t, err)
+			require.NoError(t, w.FlushError())
+			_, err = w.Write([]byte("tail"))
+			require.NoError(t, err)
+			w.HandlerDone()
+			assert.Equal(t, want, rec.deadlines)
+		})
+	}
+}
