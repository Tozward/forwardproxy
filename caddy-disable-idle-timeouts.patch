+// Disable disables idle and minimum-rate deadlines for the rest of the
+// request. HardDeadline and deadlines set by the handler still apply.
+func (r *IdleTimeoutReader) Disable() {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+
+	if r.finished || r.idleDisabled {
+		return
+	}
+	r.idleDisabled = true
+	if r.unsupported || r.armed == deadlineHard || r.keepExpiredLocked() {
+		return
+	}
+	ceiling := r.ceilingLocked()
+	if r.armed == deadlineIdle || !ceiling.IsZero() {
+		r.installCeilingLocked(ceiling)
+	}
+}
