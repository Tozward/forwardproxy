+func TestIdleTimeoutReaderDisableBeforeRead(t *testing.T) {
+	rec := &readDeadlineRecorder{ResponseRecorder: httptest.NewRecorder()}
+	r := &IdleTimeoutReader{
+		ReadCloser:        io.NopCloser(strings.NewReader("ab")),
+		Ctrl:              http.NewResponseController(rec),
+		Deadline:          IdleDeadline{Timeout: time.Minute, MinRate: 10},
+		Logger:            zap.NewNop(),
+		DrainDeadline:     true,
+		ClearBetweenReads: true,
+	}
+	r.Disable()
+	_, err := r.Read(make([]byte, 1))
+	require.NoError(t, err)
+	r.HandlerDone()
+	assert.Empty(t, rec.snapshot(), "neither a read nor HandlerDone should arm an idle deadline")
+}
