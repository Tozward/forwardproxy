+func TestIdleTimeoutWriterDisablePreservesCeilings(t *testing.T) {
+	now := time.Now()
+	hard := now.Add(time.Hour)
+	handler := now.Add(30 * time.Minute)
+	rec := &writeDeadlineRecorder{ResponseRecorder: httptest.NewRecorder()}
+	w := &IdleTimeoutWriter{
+		ResponseWriterWrapper: &ResponseWriterWrapper{ResponseWriter: rec},
+		Ctrl:                  http.NewResponseController(rec),
+		Deadline:              IdleDeadline{Timeout: time.Minute, HardDeadline: hard},
+		Logger:                zap.NewNop(),
+	}
+	require.NoError(t, w.SetWriteDeadline(handler))
+	require.NoError(t, w.FlushError())
+	w.Disable()
+	require.Equal(t, handler, rec.deadlines[len(rec.deadlines)-1])
+	require.False(t, w.deadlineSet)
+	require.NoError(t, w.SetWriteDeadline(now.Add(2*time.Hour)))
+	require.NoError(t, w.SetWriteDeadline(time.Time{}))
+	require.NoError(t, w.FlushError())
+	assert.Equal(t, []time.Time{handler, hard, hard}, rec.deadlines[2:])
+}
